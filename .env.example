# ==============================================================================
# Residence SaaS - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific credentials:
#   cp .env.example .env
#
# IMPORTANT: In production (ENVIRONMENT=production), the application will fail
# to start if default or insecure secrets are detected.
# ==============================================================================

# --- Application & Environment ---
PROJECT_NAME="Residence SaaS"
ENVIRONMENT="development"                      # Options: development | staging | production
ALLOWED_ORIGINS='["http://localhost:3000", "http://localhost:8000", "*"]'

# --- Tenant & User Security ---
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="change_this_to_a_cryptographically_secure_random_key_min_32_bytes"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=11520              # 8 days (60 * 24 * 8)

# --- SaaS Platform Admin Security (Cryptographically Isolated Domain) ---
# MUST be completely distinct from SECRET_KEY.
SAAS_ADMIN_SECRET_KEY="change_this_to_a_unique_saas_admin_jwt_secret_min_32_bytes"
SAAS_ADMIN_PASSWORD_PEPPER="change_this_to_a_unique_hmac_sha256_pepper_secret_min_32_bytes"

# --- Primary Database (PostgreSQL) ---
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_secure_password"
POSTGRES_DB="residence_db"
# App traffic — prefer PgBouncer in production (transaction pooling):
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@pgbouncer:6432/residence_db"
# Migrations / Alembic must bypass the pooler:
# DIRECT_DATABASE_URL="postgresql+asyncpg://postgres:postgres@db:5432/residence_db"
DB_USE_PGBOUNCER="false"
DB_POOL_SIZE="5"
DB_MAX_OVERFLOW="5"
DB_POOL_RECYCLE="300"

# Worker flushes Redis → Postgres queues every ~2s in batches
ACCESS_LOG_DRAIN_INTERVAL_SECONDS="2"
ACCESS_LOG_DRAIN_BATCH_SIZE="500"
TOKEN_STATE_DRAIN_INTERVAL_SECONDS="2"
TOKEN_STATE_DRAIN_BATCH_SIZE="500"

# --- In-Memory Caching, Rate-Limiting & Token Revocation (Redis) ---
REDIS_URL="redis://localhost:6379/0"

# --- Email Notifications & Gate Alerts (Resend.com) ---
# Sign up at https://resend.com to generate your API key
RESEND_API_KEY=""                              # Leave blank for simulated console logs in development
RESEND_SENDER_EMAIL="onboarding@resend.dev"    # In production, use your verified domain (e.g. no-reply@residence.com)
RESEND_SENDER_NAME="Residence Support"

# --- Estate Admin Subscription Billing (BACHS Payment Gateway) ---
# Dashboard: https://bachs.io (Use sandbox keys for development)
BACHS_SECRET_KEY=""                            # e.g., sk_sandbox_... or sk_live_... (Blank = simulated checkout)
BACHS_PUBLIC_KEY=""                            # e.g., pk_sandbox_... or pk_live_...
BACHS_WEBHOOK_SECRET=""                        # Secret used for HMAC-SHA256 webhook signature verification
BACHS_BASE_URL="https://sandbox-api.bachs.io"  # Use https://api.bachs.io in production
