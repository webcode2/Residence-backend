# ==============================================================================
# Residence SaaS - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific credentials:
#   cp .env.example .env
#
# IMPORTANT: In production (ENVIRONMENT=production), the application will fail
# to start if default or insecure secrets are detected.
# ==============================================================================

# --- Application & Environment ---
PROJECT_NAME="Residence SaaS"
ENVIRONMENT="development"                      # Options: development | staging | production
ALLOWED_ORIGINS='["http://localhost:3000", "http://localhost:8000", "*"]'

# --- Tenant & User Security ---
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="change_this_to_a_cryptographically_secure_random_key_min_32_bytes"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=11520              # 8 days (60 * 24 * 8)

# --- SaaS Platform Admin Security (Cryptographically Isolated Domain) ---
# MUST be completely distinct from SECRET_KEY.
SAAS_ADMIN_SECRET_KEY="change_this_to_a_unique_saas_admin_jwt_secret_min_32_bytes"
SAAS_ADMIN_PASSWORD_PEPPER="change_this_to_a_unique_hmac_sha256_pepper_secret_min_32_bytes"

# Platform owner (SaaS admin) for /owner/login. Created on startup only if no account
# with this email exists; an existing account is never modified. Password: 8+ chars.
PLATFORM_OWNER_EMAIL=""
PLATFORM_OWNER_PASSWORD=""
PLATFORM_OWNER_NAME="Residence Platform Owner"

# --- Primary Database (Neon PostgreSQL) ---
# MVP: no local Postgres container and no PgBouncer. Use the Neon connection string.
# Prefer the Neon pooler endpoint for app traffic. Keep the real URL in .env / secrets.
# DB_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/residence_db?sslmode=require"
# Optional: use Neon's direct endpoint for Alembic migrations (recommended).
# DIRECT_DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/residence_db?sslmode=require"
DB_USE_PGBOUNCER="false"
DB_POOL_SIZE="5"
DB_MAX_OVERFLOW="5"
DB_POOL_RECYCLE="300"
# Ping a pooled connection only after it sat idle this many seconds (0 = every checkout).
DB_POOL_PING_IDLE_SECONDS="30"
# Connections each worker opens at startup so first requests skip the handshake.
DB_POOL_WARM_CONNECTIONS="2"

# Worker flushes Redis → Postgres queues every ~2s in batches
ACCESS_LOG_DRAIN_INTERVAL_SECONDS="2"
ACCESS_LOG_DRAIN_BATCH_SIZE="500"
TOKEN_STATE_DRAIN_INTERVAL_SECONDS="2"
TOKEN_STATE_DRAIN_BATCH_SIZE="500"

# --- Background workers / scheduler ---
# Run in-process background workers in the API process. Set false when using a dedicated
# `python worker.py --daemon` process (docker-compose.prod.yml does this).
ENABLE_EMBEDDED_WORKERS="true"
ENABLE_MAINTENANCE_SCHEDULER="true"
MAINTENANCE_INTERVAL_SECONDS="3600"

# --- In-Memory Caching, Rate-Limiting & Token Revocation (Redis) ---
# MVP: Redis is remote (Upstash). Copy the TLS URL from the Upstash dashboard.
# Never commit the real token — keep it in .env / deployment secrets only.
# Format: rediss://default:<UPSTASH_REDIS_TOKEN>@<host>.upstash.io:6379
REDIS_URL="rediss://default:replace_with_upstash_token@your-upstash-host.upstash.io:6379"

# --- Firebase Cloud Messaging (chat push) ---
# Download a service-account JSON from Firebase Console > Project settings > Service accounts.
# Keep that file in the backend directory and out of git (*firebase-adminsdk*.json is ignored).
FCM_PROJECT_ID="residence-elastrocloud"
FCM_SERVICE_ACCOUNT_FILE="residence-elastrocloud-firebase-adminsdk-fbsvc.json"
FCM_ANDROID_CHANNEL_ID="residence_chat"

# --- Email Notifications & Gate Alerts (Resend.com) ---
# Sign up at https://resend.com to generate your API key
RESEND_API_KEY=""                              # Required for landlord welcome emails; leave blank only for local realtime-alert simulation
RESEND_SENDER_EMAIL="onboarding@resend.dev"    # In production, use your verified domain (e.g. no-reply@residence.com)
RESEND_SENDER_NAME="Residence Support"

# --- Estate Admin Subscription Billing (BACHS Payment Gateway) ---
# Dashboard: https://bachs.io (Use sandbox keys for development)
BACHS_SECRET_KEY=""                            # e.g., sk_sandbox_... or sk_live_... (Blank = simulated checkout)
BACHS_PUBLIC_KEY=""                            # e.g., pk_sandbox_... or pk_live_...
BACHS_WEBHOOK_SECRET=""                        # Secret used for HMAC-SHA256 webhook signature verification
BACHS_BASE_URL="https://sandbox-api.bachs.io"  # Use https://api.bachs.io in production

# Days of free access after hosted card verification; applies to new estates only.
ESTATE_TRIAL_DAYS=14
